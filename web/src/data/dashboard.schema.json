{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Research dashboard export v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "sections": {
      "type": "object",
      "properties": {
        "market": {
          "$ref": "#/definitions/section"
        },
        "risk-return": {
          "$ref": "#/definitions/section"
        },
        "portfolio": {
          "$ref": "#/definitions/section"
        },
        "stress": {
          "$ref": "#/definitions/section"
        },
        "momentum": {
          "type": "object",
          "properties": {
            "status": {
              "const": "awaiting"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["status", "reason"],
          "additionalProperties": false
        }
      },
      "required": ["market", "risk-return", "portfolio", "stress", "momentum"],
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "generatedAt", "sections"],
  "additionalProperties": false,
  "definitions": {
    "section": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "awaiting"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["status", "reason"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "available"
            },
            "source": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "asOf": {
                  "type": "string",
                  "format": "date"
                },
                "period": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "string",
                      "format": "date"
                    },
                    "end": {
                      "type": "string",
                      "format": "date"
                    }
                  },
                  "required": ["start", "end"],
                  "additionalProperties": false
                },
                "methodology": {
                  "type": "string",
                  "minLength": 1
                },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 0
                }
              },
              "required": [
                "path",
                "label",
                "asOf",
                "period",
                "methodology",
                "notes"
              ],
              "additionalProperties": false
            },
            "metrics": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": ["number", "null"]
                  },
                  "unit": {
                    "enum": ["number", "percent", "ratio"]
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["id", "label", "value", "unit", "note"],
                "additionalProperties": false
              },
              "minItems": 0
            },
            "charts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "enum": ["line", "bar", "scatter"]
                  },
                  "xLabel": {
                    "type": "string",
                    "minLength": 1
                  },
                  "yLabel": {
                    "type": "string",
                    "minLength": 1
                  },
                  "xUnit": {
                    "enum": ["text", "number", "percent", "ratio"]
                  },
                  "unit": {
                    "enum": ["number", "percent", "ratio"]
                  },
                  "series": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "points": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "x": {
                                "type": ["string", "number"]
                              },
                              "y": {
                                "type": ["number", "null"]
                              }
                            },
                            "required": ["x", "y"],
                            "additionalProperties": false
                          },
                          "minItems": 1
                        }
                      },
                      "required": ["id", "label", "points"],
                      "additionalProperties": false
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "id",
                  "title",
                  "description",
                  "kind",
                  "xLabel",
                  "yLabel",
                  "xUnit",
                  "unit",
                  "series"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            },
            "tables": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "minLength": 1
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "unit": {
                          "enum": ["text", "number", "percent", "ratio"]
                        }
                      },
                      "required": ["key", "label", "unit"],
                      "additionalProperties": false
                    },
                    "minItems": 1
                  },
                  "rows": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "cells": {
                          "type": "array",
                          "items": {
                            "type": ["string", "number", "null"]
                          },
                          "minItems": 1
                        }
                      },
                      "required": ["id", "cells"],
                      "additionalProperties": false
                    },
                    "minItems": 1
                  }
                },
                "required": ["id", "title", "description", "columns", "rows"],
                "additionalProperties": false
              },
              "minItems": 0
            }
          },
          "required": ["status", "source", "metrics", "charts", "tables"],
          "additionalProperties": false,
          "anyOf": [
            {
              "properties": {
                "metrics": {
                  "minItems": 1,
                  "type": "array"
                }
              }
            },
            {
              "properties": {
                "charts": {
                  "minItems": 1,
                  "type": "array"
                }
              }
            },
            {
              "properties": {
                "tables": {
                  "minItems": 1,
                  "type": "array"
                }
              }
            }
          ]
        }
      ]
    }
  }
}
